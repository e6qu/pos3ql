CREATE TABLE slt_trigger_query_loop_target (id integer PRIMARY KEY, value integer)

statement ok
CREATE TABLE slt_trigger_query_loop_audit (value integer)

statement ok
CREATE FUNCTION slt_trigger_query_loop_program() RETURNS trigger LANGUAGE plpgsql AS
'DECLARE item integer; BEGIN FOR item IN SELECT value FROM changed_rows ORDER BY value LOOP CONTINUE WHEN item = 2; INSERT INTO slt_trigger_query_loop_audit VALUES (item); EXIT WHEN item = 3; END LOOP; RETURN NULL; END'

statement ok
CREATE TRIGGER slt_trigger_query_loop_after AFTER UPDATE ON slt_trigger_query_loop_target
REFERENCING NEW TABLE AS changed_rows FOR EACH STATEMENT EXECUTE FUNCTION slt_trigger_query_loop_program()

