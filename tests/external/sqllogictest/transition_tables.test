CREATE TABLE slt_trigger_conflict_driver (id integer PRIMARY KEY, value integer)

statement ok
CREATE TABLE slt_trigger_conflict_target (id integer PRIMARY KEY, value integer)

statement ok
CREATE FUNCTION slt_trigger_conflict_program() RETURNS trigger LANGUAGE plpgsql AS
'DECLARE step integer := NEW.value - OLD.value; BEGIN INSERT INTO slt_trigger_conflict_target VALUES (NEW.id, NEW.value) ON CONFLICT (id) DO UPDATE SET value = excluded.value + step WHERE step = 2 AND OLD.value = 5 AND NEW.value = 7; RETURN NEW; END'

statement ok
CREATE TRIGGER slt_trigger_conflict_after AFTER UPDATE ON slt_trigger_conflict_driver
FOR EACH ROW EXECUTE FUNCTION slt_trigger_conflict_program()

statement ok
