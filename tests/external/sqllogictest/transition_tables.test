# PostgreSQL transition relations are statement-local typed relations, not
# text substitutions. Keep all three DML shapes in the SQLLogicTest replay.

statement ok
CREATE TABLE slt_transition_target (id integer PRIMARY KEY, value integer)

statement ok
CREATE TABLE slt_transition_audit (kind text, id integer, value integer)

statement ok
CREATE FUNCTION slt_transition_insert() RETURNS trigger LANGUAGE plpgsql AS
'BEGIN INSERT INTO slt_transition_audit SELECT ''insert'', id, value FROM inserted_rows; RETURN NULL; END'

statement ok
CREATE FUNCTION slt_transition_update() RETURNS trigger LANGUAGE plpgsql AS
'BEGIN INSERT INTO slt_transition_audit SELECT ''update-old'', id, value FROM old_rows; INSERT INTO slt_transition_audit SELECT ''update-new'', id, value FROM new_rows; RETURN NULL; END'

statement ok
CREATE FUNCTION slt_transition_delete() RETURNS trigger LANGUAGE plpgsql AS
'BEGIN INSERT INTO slt_transition_audit SELECT ''delete'', id, value FROM deleted_rows; RETURN NULL; END'

statement ok
CREATE TRIGGER slt_transition_insert AFTER INSERT ON slt_transition_target
REFERENCING NEW TABLE AS inserted_rows FOR EACH STATEMENT EXECUTE FUNCTION slt_transition_insert()

statement ok
CREATE TRIGGER slt_transition_update AFTER UPDATE ON slt_transition_target
REFERENCING OLD TABLE AS old_rows NEW TABLE AS new_rows FOR EACH STATEMENT EXECUTE FUNCTION slt_transition_update()

statement ok
CREATE TRIGGER slt_transition_delete AFTER DELETE ON slt_transition_target
REFERENCING OLD TABLE AS deleted_rows FOR EACH STATEMENT EXECUTE FUNCTION slt_transition_delete()

statement ok
INSERT INTO slt_transition_target VALUES (1, 10), (2, 20)

statement ok
UPDATE slt_transition_target SET value = value + 1 WHERE id = 1

statement ok
DELETE FROM slt_transition_target WHERE id = 2

query TII rowsort
SELECT kind, id, value FROM slt_transition_audit ORDER BY kind, id, value
----
delete 2 20
insert 1 10
insert 2 20
update-new 1 11
update-old 1 10

statement ok
DROP TABLE slt_transition_target

statement ok
DROP TABLE slt_transition_audit

statement ok
DROP FUNCTION slt_transition_delete()

statement ok
DROP FUNCTION slt_transition_update()

statement ok
DROP FUNCTION slt_transition_insert()

statement ok
CREATE TABLE slt_local_query_target (id integer PRIMARY KEY, value integer)

statement ok
CREATE TABLE slt_local_query_audit (changed integer)

statement ok
CREATE FUNCTION slt_local_query_program() RETURNS trigger LANGUAGE plpgsql AS
'DECLARE changed_count integer; BEGIN SELECT count(*) INTO changed_count FROM changed_rows; PERFORM 1 FROM changed_rows WHERE value > 0; INSERT INTO slt_local_query_audit VALUES (changed_count); RETURN NULL; END'

statement ok
CREATE TRIGGER slt_local_query_after AFTER UPDATE ON slt_local_query_target
REFERENCING NEW TABLE AS changed_rows FOR EACH STATEMENT EXECUTE FUNCTION slt_local_query_program()

statement ok
INSERT INTO slt_local_query_target VALUES (1, 10), (2, 20)

statement ok
UPDATE slt_local_query_target SET value = value + 1

query I rowsort
SELECT changed FROM slt_local_query_audit
----
2

statement ok
DROP TABLE slt_local_query_target

statement ok
DROP TABLE slt_local_query_audit

statement ok
DROP FUNCTION slt_local_query_program()

statement ok
CREATE TABLE slt_transition_dml_driver (id integer PRIMARY KEY, delta integer)

statement ok
CREATE TABLE slt_transition_dml_target (id integer PRIMARY KEY, value integer)

statement ok
CREATE FUNCTION slt_transition_dml_program() RETURNS trigger LANGUAGE plpgsql AS
'BEGIN UPDATE slt_transition_dml_target SET value = slt_transition_dml_target.value + changed_rows.delta FROM changed_rows WHERE slt_transition_dml_target.id = changed_rows.id; DELETE FROM slt_transition_dml_target USING changed_rows WHERE slt_transition_dml_target.id = changed_rows.id AND changed_rows.delta = 9; RETURN NULL; END'

statement ok
CREATE TRIGGER slt_transition_dml_after AFTER UPDATE ON slt_transition_dml_driver
REFERENCING NEW TABLE AS changed_rows FOR EACH STATEMENT EXECUTE FUNCTION slt_transition_dml_program()

statement ok
